# ER-4 (CN7130, 4 cores, 1 GiB) additions on top of cavium_octeon_defconfig.
# Picked from Ubiquiti's ubnt_er_e300_defconfig (4.9.79).
CONFIG_NR_CPUS=4
# Octeon II ISA (saa etc.), same as Ubiquiti; the SDK code needs it
CONFIG_CAVIUM_OCTEON2=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_MTD=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Oracle DTrace type data: needs host libdw and is not useful on the router
# CONFIG_CTF is not set
# UEK backports BPF ringbuf into net/core/filter.c without guarding it; needs BPF_SYSCALL
CONFIG_BPF_SYSCALL=y
# Ubiquiti's kernel isn't preemptible; the SDK code assumes that (smp_processor_id BUGs otherwise)
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT is not set
# CONFIG_DEBUG_PREEMPT is not set
# Initramfs for standalone netbooted test kernels (relative to the kernel build dir).
# tools/kernel-config.sh drops this line from config-5.15: OpenWrt builds its own initramfs.
CONFIG_INITRAMFS_SOURCE="../initramfs.list"
# Cavium/Ubiquiti flow offload hooks (sk_buff metadata, dev.c rx/tx hooks)
CONFIG_CAVIUM_NET_PACKET_FWD_OFFLOAD=y
CONFIG_CAVIUM_IPFWD_OFFLOAD=y
# Fixed version string so out-of-tree modules keep matching (no git describe suffix)
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-er4"
# --- Router features (the Octeon defconfig is a bare dev config) ---
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
# Software QoS: CAKE as the baseline, HTB/PRIO for priority classes,
# ingress shaping via IFB + mirred. Built in but unused unless tc configures them
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_IFB=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_PPP=y
CONFIG_PPPOE=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
# IPsec / IKEv2 (strongSwan, VPN page). The Octeon's COP2 AES was used only by Ubiquiti's
# cvm-ipsec-kame, which isn't ported; uek7 patch 0009 adds kernel crypto drivers for it (below).
# The offload module doesn't learn ESP flows (the length check in cvm_ipfwd_ip_cache_flow fails
# after encapsulation); check on hardware that tunnelled traffic is never forwarded in clear.
CONFIG_XFRM_USER=y
# A module, not built in: OpenWrt's netifd proto handler (xfrm.sh) only registers when
# /sys/module/xfrm_interface exists, which a built-in without parameters never has; built in,
# every 'proto xfrm' interface stayed NO_DEVICE and the routes over it were never installed.
CONFIG_XFRM_INTERFACE=m
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_NFT_XFRM=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
# OpenWrt's kmod-ipsec/ipsec4/ipsec6 (strongSwan selects them) package these as modules: with
# them built in the packages are empty, but the files must exist or be listed as builtin
CONFIG_NET_KEY=y
CONFIG_INET_AH=y
CONFIG_INET6_AH=y
CONFIG_INET_IPCOMP=y
CONFIG_INET6_IPCOMP=y
CONFIG_INET_XFRM_TUNNEL=y
CONFIG_INET6_XFRM_TUNNEL=y
CONFIG_INET6_TUNNEL=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_DH=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRC_CCITT=y
# IPsec on the Octeon crypto unit: our own AES (ecb/cbc/ctr) and GHASH drivers
# (uek7 arch/mips/cavium-octeon/crypto/octeon-{aes,ghash}.c) plus the upstream Octeon SHA
# drivers built in, so ESP's gcm(aes) and cbc(aes)+hmac(sha*) run on COP2. Self-tests on:
# an algorithm that fails them is never used (the generic one is). tcrypt for benchmarks.
CONFIG_CRYPTO_AES_OCTEON=y
CONFIG_CRYPTO_GHASH_OCTEON=y
CONFIG_CRYPTO_SHA1_OCTEON=y
CONFIG_CRYPTO_SHA256_OCTEON=y
CONFIG_CRYPTO_SHA512_OCTEON=y
# CONFIG_CRYPTO_MANAGER_DISABLE_TESTS is not set
CONFIG_CRYPTO_TEST=m
# --- OpenWrt userland requirements ---
# fw4 (nftables): sets/maps live in a separate module on 5.4
CONFIG_NF_TABLES_SET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_OBJREF=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_DUP_IPV4=y
CONFIG_NFT_DUP_IPV6=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
# procd ujail / service sandboxing
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_XATTR=y
# --- UEK7 (5.15) build fixes: Oracle doesn't build MIPS, so some combos rot ---
# msi-octeon.c still uses the pre-5.17 MSI iterators that UEK7 backported away; ER-4 has no PCIe devices
# CONFIG_PCI_MSI is not set
# include/net/tc_wrapper.h needs struct tc_action_ops (NET_CLS_ACT); useful on a router anyway
CONFIG_NET_CLS_ACT=y
# nft/fw4 "log" needs a logging backend (otherwise: "Could not process rule")
CONFIG_NF_LOG_SYSLOG=y
# --- Hardening ---
# Kernel memory views nothing here uses (OpenWrt, test tools)
# CONFIG_PROC_KCORE is not set
# CONFIG_DEVMEM is not set
# debugfs stays available to drivers but can't be mounted
CONFIG_DEBUG_FS_DISALLOW_MOUNT=y
# Bounds checks on copies to/from userspace and on fixed-size string/memory ops
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
# Make heap corruption (e.g. a use-after-free) harder to exploit and quicker to crash
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
# 6in4 (an IPv6 tunnel broker such as Hurricane Electric, Network page). SIT is built
# in; kmod-sit (which the 6in4 proto selects) also asks for 6RD
CONFIG_IPV6_SIT=y
CONFIG_IPV6_SIT_6RD=y
# Source-specific IPv6 routes: netifd installs every IPv6 uplink's default route "from" its
# prefix (DHCPv6-PD, 6in4). Without subtrees the kernel refuses them and the router has no IPv6
# default route (found on hardware with a 6in4 tunnel). OpenWrt sets this through
# its own CONFIG_KERNEL_IPV6_SUBTREES, which doesn't reach our external kernel config.
CONFIG_IPV6_SUBTREES=y
