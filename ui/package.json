{
  "name": "er4-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Web UI for the EdgeRouter 4 OpenWrt image: a Preact single-page app over ubus JSON-RPC",
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "uplot": "^1.6.32",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
