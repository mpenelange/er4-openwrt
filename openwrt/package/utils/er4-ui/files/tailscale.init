#!/bin/sh /etc/rc.common

# Copyright 2020 Google LLC.
# Copyright (C) 2021 CZ.NIC z.s.p.o. (https://www.nic.cz/)
# SPDX-License-Identifier: Apache-2.0
# From OpenWrt's tailscale package (feeds/packages net/tailscale), changed for the ER-4: the
# binaries are Tailscale's own build on the eMMC (/usr/libexec/er4-tailscale-fetch installs
# them), so Tailscale can update itself and the update survives reboots.

USE_PROCD=1
START=80

DIR=/mnt/er4data/er4/tailscale

start_service() {
  local state_file
  local port
  local quiet_log

  if [ ! -x $DIR/tailscaled ]; then
    # set up before but the binary is gone (a fresh eMMC data partition): fetch it again, then start
    [ -s /etc/tailscale/tailscaled.state ] && /usr/libexec/er4-tailscale-fetch --boot </dev/null >/dev/null 2>&1 &
    return 0
  fi

  config_load tailscale
  config_get_bool quiet_log "settings" quiet_log 1
  config_get port "settings" port 41641
  config_get state_file "settings" state_file /etc/tailscale/tailscaled.state
  config_get fw_mode "settings" fw_mode nftables

  $DIR/tailscaled --cleanup

  procd_open_instance
  # through er4-tailscaled-log: logged at info level, routine chatter dropped unless quiet_log=0
  procd_set_param command /usr/libexec/er4-tailscaled-log $DIR/tailscaled

  # Starting with v1.48.1 ENV variable is required to enable use of iptables / nftables.
  procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"

  # Disable logging to log.tailscale.com
  procd_append_param env TS_NO_LOGS_NO_SUPPORT=true
  procd_append_param env ER4_TS_QUIET="$quiet_log"

  procd_append_param command --port "$port"
  procd_append_param command --state "$state_file"

  procd_set_param respawn

  procd_close_instance
}

stop_service() {
  [ -x $DIR/tailscaled ] && $DIR/tailscaled --cleanup
}
