config offload 'global'
	option enabled '1'
	option ipv4 '1'
	# IPv6: tested on hardware (forwarding, NAT and port checks; 16% vs 55% router CPU)
	option ipv6 '1'
	# 802.1Q subinterfaces (eth0.30 etc.)
	option vlan '1'
	# PPPoE offload is untested on this port
	option pppoe '0'
	# counters in /proc/cavium/stats (fast-path hit rate on the web UI dashboard); costs
	# ~3 points of CPU at 790 kpps of 64-byte packets, well under 1 at normal packet sizes
	option stats '1'
