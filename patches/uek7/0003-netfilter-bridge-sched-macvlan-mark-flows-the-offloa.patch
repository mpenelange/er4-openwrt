diff --git a/include/linux/netfilter/x_tables.h b/include/linux/netfilter/x_tables.h
index 55399a324..5b1de179f 100644
--- a/include/linux/netfilter/x_tables.h
+++ b/include/linux/netfilter/x_tables.h
@@ -40,6 +40,10 @@ struct xt_action_param {
 	unsigned int thoff;
 	u16 fragoff;
 	bool hotdrop;
+#ifdef CONFIG_CAVIUM_NET_PACKET_FWD_OFFLOAD
+	/* SKB_CVM_RESERVED_* bits collected during table traversal */
+	u16 cvm_reserved;
+#endif
 };
 
 static inline struct net *xt_net(const struct xt_action_param *par)
@@ -146,6 +150,11 @@ struct xt_match {
 	const char name[XT_EXTENSION_MAXNAMELEN];
 	u_int8_t revision;
 
+#ifdef CONFIG_CAVIUM_NET_PACKET_FWD_OFFLOAD
+	/* Evaluating this extension needs every packet: don't offload the flow */
+	bool cvm_no_offload;
+#endif
+
 	/* Return true or false: return FALSE and set *hotdrop = 1 to
            force immediate packet drop. */
 	/* Arguments changed since 2.6.9, as this must now handle
@@ -186,6 +195,11 @@ struct xt_target {
 	const char name[XT_EXTENSION_MAXNAMELEN];
 	u_int8_t revision;
 
+#ifdef CONFIG_CAVIUM_NET_PACKET_FWD_OFFLOAD
+	/* Evaluating this extension needs every packet: don't offload the flow */
+	bool cvm_no_offload;
+#endif
+
 	/* Returns verdict. Argument order changed since 2.6.9, as this
 	   must now handle non-linear skbs, using skb_copy_bits and
 	   skb_ip_make_writable. */
@@ -225,6 +239,43 @@ struct xt_target {
 	UEK_KABI_RESERVE(4)
 };
 
+/* Cavium flow offload: extensions that must see every packet set
+ * XT_CVM_NO_OFFLOAD in their registration; the table walkers then mark
+ * the skb so the offload engine won't cache the flow.
+ */
+#ifdef CONFIG_CAVIUM_NET_PACKET_FWD_OFFLOAD
+#define XT_CVM_NO_OFFLOAD	.cvm_no_offload = true,
+static inline void xt_cvm_reserve(struct xt_action_param *par)
+{
+	par->cvm_reserved |= SKB_CVM_RESERVED_1;
+}
+static inline void xt_cvm_begin(struct xt_action_param *par)
+{
+	par->cvm_reserved = 0;
+}
+static inline void xt_cvm_note_match(struct xt_action_param *par)
+{
+	if (par->match->cvm_no_offload)
+		xt_cvm_reserve(par);
+}
+static inline void xt_cvm_note_target(struct xt_action_param *par)
+{
+	if (par->target->cvm_no_offload)
+		xt_cvm_reserve(par);
+}
+static inline void xt_cvm_commit(struct sk_buff *skb, const struct xt_action_param *par)
+{
+	skb_cvm_reserve(skb, par->cvm_reserved);
+}
+#else
+#define XT_CVM_NO_OFFLOAD
+static inline void xt_cvm_reserve(struct xt_action_param *par) { }
+static inline void xt_cvm_begin(struct xt_action_param *par) { }
+static inline void xt_cvm_note_match(struct xt_action_param *par) { }
+static inline void xt_cvm_note_target(struct xt_action_param *par) { }
+static inline void xt_cvm_commit(struct sk_buff *skb, const struct xt_action_param *par) { }
+#endif
+
 /* Furniture shopping... */
 struct xt_table {
 	struct list_head list;
