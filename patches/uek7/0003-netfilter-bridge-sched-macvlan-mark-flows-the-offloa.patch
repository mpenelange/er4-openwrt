--- a/net/ipv4/netfilter/ip_tables.c
+++ b/net/ipv4/netfilter/ip_tables.c
@@ -254,6 +254,7 @@ ipt_do_table(struct sk_buff *skb,
 	acpar.thoff   = ip_hdrlen(skb);
 	acpar.hotdrop = false;
 	acpar.state   = state;
+	xt_cvm_begin(&acpar);
 
 	WARN_ON(!(table->valid_hooks & (1 << hook)));
 	local_bh_disable();
@@ -291,6 +292,7 @@ ipt_do_table(struct sk_buff *skb,
 		xt_ematch_foreach(ematch, e) {
 			acpar.match     = ematch->u.kernel.match;
 			acpar.matchinfo = ematch->data;
+			xt_cvm_note_match(&acpar);
 			if (!acpar.match->match(skb, &acpar))
 				goto no_match;
 		}
@@ -343,6 +345,7 @@ ipt_do_table(struct sk_buff *skb,
 		acpar.target   = t->u.kernel.target;
 		acpar.targinfo = t->data;
 
+		xt_cvm_note_target(&acpar);
 		verdict = t->u.kernel.target->target(skb, &acpar);
 		if (verdict == XT_CONTINUE) {
 			/* Target might have changed stuff. */
@@ -354,6 +357,7 @@ ipt_do_table(struct sk_buff *skb,
 		}
 	} while (!acpar.hotdrop);
 
+	xt_cvm_commit(skb, &acpar);
 	xt_write_recseq_end(addend);
 	local_bh_enable();
 
diff --git a/net/ipv6/netfilter/ip6_tables.c b/net/ipv6/netfilter/ip6_tables.c
