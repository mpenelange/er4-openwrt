From f90e67b7c0b927697cefb49888b3d308092ce92b Mon Sep 17 00:00:00 2001
From: mpenelange <191051681+mpenelange@users.noreply.github.com>
Date: Sun, 11 Oct 2026 21:41:19 -0500
Subject: [PATCH 11/18] Key the flow-cache bucket hash with a per-boot random key

The bucket index was CRC32C (poly 0x1edc6f41, fixed IV 0) over the tuple:
unkeyed and identical every boot, so anyone could
precompute tuples that share a victim flow's bucket and, with only 2
entries per bucket, evict it to the slow path at will -- a cheap targeted
fast-path DoS on an internet-facing router.

A random CRC IV does not fix this: for equal-length inputs the IV cancels
out of the XOR of two CRCs. Replace the Octeon CRC unit with the kernel's
keyed hsiphash over the same tuple words, seeded once per boot from
net_get_random_once(), as mainline conntrack does. Bucket placement is now
unpredictable off-box; on-box forwarding behaviour is unchanged.

Tested on the ER-4 with a bucket-collision test. On the old-CRC build, two
precomputed source ports (1357, 1470) both hash to the victim's bucket and
evict it (victim present in 1/4 snapshots under attack). On this build the
same ports scatter to other buckets (58, 38) while the victim sits in
bucket 57 and stays offloaded (4/4). The ingress-port and flow-churn tests
still pass.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 platform/octeon/src/platform_api.c | 114 +++++++++++------------------
 1 file changed, 44 insertions(+), 70 deletions(-)

diff --git a/platform/octeon/src/platform_api.c b/platform/octeon/src/platform_api.c
index 1113e55..a97a882 100644
--- a/platform/octeon/src/platform_api.c
+++ b/platform/octeon/src/platform_api.c
@@ -19,95 +19,69 @@
 #include <linux/cache.h>
 #include <asm/barrier.h>
 #include <linux/crc32.h>
+#include <linux/siphash.h>
+#include <linux/net.h>
 
 #include "platform_api.h"
 
+/*
+ * Flow cache bucket index. This used to be the CPU's CRC unit (CRC32C, fixed
+ * IV) over the tuple: unkeyed and linear, so anyone could compute tuples that
+ * share a bucket with a victim flow and keep evicting it to the slow path
+ * (security audit F4). A random CRC IV would not help: for equal-length
+ * inputs the IV cancels out of the XOR of two CRCs. Use the kernel's keyed
+ * hsiphash with a per-boot random key, as mainline does for conntrack.
+ */
+static hsiphash_key_t ipfwd_hash_key __read_mostly;
+
 int platform_get_hash_bucket(struct sk_buff *skb, void *iph, struct tcphdr *th, 
 								struct cvm_packet_info *cvm_info, bool ip6)
 {
-	u64 sdaddr;
-	u32 saddr, daddr, out_saddr, out_daddr;
-	u32 sdport;
-	u16 out_sport, out_dport;
-	u8 proto, out_proto;
-	u32 gre_key;
-	int idx;
+	u32 w[16];
+	int n = 0;
+	u32 idx;
 
-	set_c0_status(ST0_CU2);
-
-	CVMX_MT_CRC_POLYNOMIAL (0x1edc6f41);
-	CVMX_MT_CRC_IV (0);
+	net_get_random_once(&ipfwd_hash_key, sizeof(ipfwd_hash_key));
 
 	if (ip6) {
-		struct ipv6hdr *ip;
-		ip = (struct ipv6hdr *)iph;
-		sdaddr = *(u64 *)&ip->saddr;
-		CVMX_MT_CRC_DWORD (sdaddr);
-
-		sdaddr = *((u64 *)&ip->saddr + 1);
-		CVMX_MT_CRC_DWORD (sdaddr);
+		struct ipv6hdr *ip = (struct ipv6hdr *)iph;
 
-		proto = ip->nexthdr;
-		CVMX_MT_CRC_BYTE (proto);
+		memcpy(&w[n], &ip->saddr, 16);
+		n += 4;
+		memcpy(&w[n], &ip->daddr, 16);
+		n += 4;
+		w[n++] = ip->nexthdr;
 	} else {
-		struct iphdr *ip;
-		ip = (struct iphdr *)iph;
-		saddr = ip->saddr;
-		CVMX_MT_CRC_WORD (saddr);
+		struct iphdr *ip = (struct iphdr *)iph;
 
-		daddr = ip->daddr;
-		CVMX_MT_CRC_WORD (daddr);
-
-		proto = ip->protocol;
-		CVMX_MT_CRC_BYTE (proto);
+		w[n++] = ip->saddr;
+		w[n++] = ip->daddr;
+		w[n++] = ip->protocol;
 	}
-
-	sdport = *(u32*)&th->source;
-	CVMX_MT_CRC_WORD (sdport);
+	w[n++] = *(u32 *)&th->source;	/* source and destination port */
 
 	if (cvm_info->rx_pkt_flags) {
-		if (test_vlan_hdr(&cvm_info->rx_pkt_flags)) {
-			int vlan_tci = cvm_info->vlan.h_vlan_TCI;	
-			CVMX_MT_CRC_WORD(vlan_tci);	
+		if (test_vlan_hdr(&cvm_info->rx_pkt_flags))
+			w[n++] = cvm_info->vlan.h_vlan_TCI;
+		if (test_pppoe_hdr(&cvm_info->rx_pkt_flags))
+			w[n++] = cvm_info->pppoe.sid;
+		if (!ip6 && test_vxlan_hdr(&cvm_info->rx_pkt_flags)) {
+			w[n++] = cvm_info->vxlan.vx_vni;
+			w[n++] = cvm_info->outer_ip4.saddr;
+			w[n++] = cvm_info->outer_ip4.daddr;
+			w[n++] = (cvm_info->outer_ip4.protocol << 16) ^ cvm_info->outer_udp.source;
+			w[n++] = cvm_info->outer_udp.dest;
 		}
-		if (test_pppoe_hdr(&cvm_info->rx_pkt_flags)) {
-			int pppoe_sid = cvm_info->pppoe.sid;
-			CVMX_MT_CRC_WORD(pppoe_sid);
+		if (test_gre_hdr(&cvm_info->rx_pkt_flags)) {
+			w[n++] = cvm_info->outer_ip4.saddr;
+			w[n++] = cvm_info->outer_ip4.daddr;
+			w[n++] = cvm_info->outer_ip4.protocol;
+			if (cvm_info->gre.flags & GRE_KEY)
+				w[n++] = cvm_info->gre.key;
 		}
-		if (!ip6) {
-			if (test_vxlan_hdr(&cvm_info->rx_pkt_flags)) {
-				int vx_vni = cvm_info->vxlan.vx_vni;
-				CVMX_MT_CRC_WORD(vx_vni);
-
-				out_saddr = cvm_info->outer_ip4.saddr;	
-				CVMX_MT_CRC_WORD(out_saddr);
-				out_daddr = cvm_info->outer_ip4.daddr;
-				CVMX_MT_CRC_WORD(out_daddr);
-				out_proto = cvm_info->outer_ip4.protocol;
-				CVMX_MT_CRC_BYTE(out_proto);
-				out_sport = cvm_info->outer_udp.source;
-				CVMX_MT_CRC_WORD(out_sport);
-				out_dport = cvm_info->outer_udp.dest;
-				CVMX_MT_CRC_WORD(out_dport);
-			}
-		}
-		if(test_gre_hdr(&cvm_info->rx_pkt_flags)){
-			
-			out_saddr = cvm_info->outer_ip4.saddr;	
-			CVMX_MT_CRC_WORD(out_saddr);
-			out_daddr = cvm_info->outer_ip4.daddr;
-			CVMX_MT_CRC_WORD(out_daddr);
-			out_proto = cvm_info->outer_ip4.protocol;
-			CVMX_MT_CRC_BYTE(out_proto);
-			if(cvm_info->gre.flags & GRE_KEY){
-				gre_key = cvm_info->gre.key;
-				CVMX_MT_CRC_BYTE(gre_key);
-			}
-		}		
-	
 	}
 
-	CVMX_MF_CRC_IV (idx);
+	idx = hsiphash(w, n * sizeof(u32), &ipfwd_hash_key);
 
 	if (ip6)
 		return (idx & CVM_IPV6FWD_LUT_MASK);
