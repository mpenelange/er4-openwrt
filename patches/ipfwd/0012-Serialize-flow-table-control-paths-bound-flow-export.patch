 	if (cvm_gbl_ipv4_fwd_cache) {
 		cvm_ipfwd_flush_cache(cvm_gbl_ipv4_fwd_cache, ipv4_cache_size, CVM_IPFWD_ENTRIES_PER_BUCKET);
 		vfree((void *)cvm_gbl_ipv4_fwd_cache);
