+#include <linux/mutex.h>
 #include <net/addrconf.h>
 #include <net/fib_notifier.h>
 #include <linux/module.h>
@@ -219,6 +220,15 @@ static inline void cvm_ipfwd_mq_exit(void)
 
 #endif /* CVM_IPFWD_MQUEUES_SUPPORT */
 
+/*
+ * Serializes control-plane users of the flow tables: anything that frees,
+ * replaces or resizes a table (enable/disable, cache_size, flush, stamp-wrap
+ * wipe, module exit) and anything that walks one from process context (/proc
+ * cache dumps, per-entry clear, flow export). The fast path doesn't take it;
+ * it is kept off a table by clearing the ipfwd_flags bit plus synchronize_net().
+ */
+DEFINE_MUTEX(cvm_ipfwd_table_mutex);
+
 /** IPv4 fwd cache */
 cvm_ipfwd_flow_bucket_t *cvm_gbl_ipv4_fwd_cache = NULL;
 static int cvm_ipv4_ignore_cache_flush = 0;
@@ -359,7 +369,9 @@ static int cvm_ipv6_fwd_cache_show(struct seq_file *file, void *ptr)
     seq_printf(file, "    |      |            |          |       |          |       |       |            |  ID   |      |      |L2 hlen| Src Addr | Dst Addr | Ports       | Proto | PPPOE | VLAN Tag | nfmark |\n");
     seq_printf(file, "================================================================================================================================================================================================|\n");
 
-    if (!cvm_ipv6_fwd) {
+    mutex_lock(&cvm_ipfwd_table_mutex);
+    if (!cvm_ipv6_fwd || !cvm_gbl_ipv6_fwd_cache) {
+        mutex_unlock(&cvm_ipfwd_table_mutex);
         return 0;
     }
 
@@ -440,6 +452,7 @@ static int cvm_ipv6_fwd_cache_show(struct seq_file *file, void *ptr)
         }
     }
     rcu_read_unlock();
+    mutex_unlock(&cvm_ipfwd_table_mutex);
 
     seq_printf(file, "------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|\n");
     seq_printf(file, "\n");
@@ -478,6 +491,11 @@ static ssize_t ipv6_fwd_cache_write(struct file *file, const char __user *buffer
 		if (cvm_ipv6_ignore_cache_flush)
 			break;
 
+		mutex_lock(&cvm_ipfwd_table_mutex);
+		if (!cvm_ipv6_fwd) {	/* disabled meanwhile */
+			mutex_unlock(&cvm_ipfwd_table_mutex);
+			break;
+		}
 		incr_ipfwd_flow_stat(IPV6_FLUSHES);
 		cvm_ipv6_fwd = false;
 		clear_ipv6_bit(ipfwd_flags);
@@ -488,6 +506,7 @@ static ssize_t ipv6_fwd_cache_write(struct file *file, const char __user *buffer
 		cvm_ipv6_fwd = true;
 		set_ipv6_bit(ipfwd_flags);
 		CVMX_SYNCW;
+		mutex_unlock(&cvm_ipfwd_table_mutex);
 		break;
 	default:
 		pr_err("Unknown action\n");
@@ -652,14 +671,16 @@ static ssize_t ipv4_fwd_cache_size_write(struct file *file, const char __user *i
 	buffer[size] = 0;
 	val = simple_strtoul(buffer, NULL, 10);
 
-	/* The size didn't change - do nothing. */
-	if (val == ipv4_cache_size && cvm_gbl_ipv4_fwd_cache) {
-		goto err;
+	/* Check if the value is 2^n. */
+	if (val == 0 || ((val & (val - 1)) != 0) || val > CVM_IPFWD_LUT_MAX) {
+		printk("Unsupported IPv4 forwarding cache table size %lu (must be 2^n, at most %u)\n", val, CVM_IPFWD_LUT_MAX);
+		return size;
 	}
 
-	/* Check if the value is 2^n. */
-	if (val == 0 || ((val & (val - 1)) != 0)) {
-		printk("Unsupported IPv4 forwarding cache table size %lu (must be 2^n)\n", val);
+	mutex_lock(&cvm_ipfwd_table_mutex);
+
+	/* The size didn't change - do nothing. */
+	if (val == ipv4_cache_size && cvm_gbl_ipv4_fwd_cache) {
 		goto err;
 	}
 
@@ -698,6 +719,7 @@ static ssize_t ipv4_fwd_cache_size_write(struct file *file, const char __user *i
 	set_ipv4_bit(ipfwd_flags);
 	CVMX_SYNCW;
 err:
+	mutex_unlock(&cvm_ipfwd_table_mutex);
 	return size;
 }
 
@@ -713,13 +735,16 @@ static int ipv4_fwd_cache_show(struct seq_file *file, void *ptr)
     seq_printf(file, "|         |           |            |       |            |       |       |       |      |  Src Addr   | Src port  | Dst Addr   | Dst port   | Proto | PPPOE Sess ID | VLAN Tag | TOS  | nfmark | Pkts Rcvd | Pkts Send       |\n");
     seq_printf(file, "======================================================================================================================================================================================================|\n");
 
-	if (!cvm_ipv4_fwd) {
+	mutex_lock(&cvm_ipfwd_table_mutex);
+	if (!cvm_ipv4_fwd || !cvm_gbl_ipv4_fwd_cache) {
+		mutex_unlock(&cvm_ipfwd_table_mutex);
 		return 0;
 	}
 
 	rcu_read_lock();	/* flow_info may be freed concurrently (after a grace period) */
 	print_flow_entry(file);
 	rcu_read_unlock();
+	mutex_unlock(&cvm_ipfwd_table_mutex);
 
 	seq_printf(file, "\n");
 #endif
@@ -774,6 +799,11 @@ static ssize_t ipv4_fwd_cache_write(struct file *file, const char __user *buffer
 			if (cvm_ipv4_ignore_cache_flush)
 				break;
 
+			mutex_lock(&cvm_ipfwd_table_mutex);
+			if (!cvm_ipv4_fwd) {	/* disabled meanwhile */
+				mutex_unlock(&cvm_ipfwd_table_mutex);
+				break;
+			}
 			incr_ipfwd_flow_stat(IPV4_FLUSHES);
 			cvm_ipv4_fwd = false;
 			clear_ipv4_bit(ipfwd_flags);
@@ -784,6 +814,7 @@ static ssize_t ipv4_fwd_cache_write(struct file *file, const char __user *buffer
 			cvm_ipv4_fwd = true;
 			set_ipv4_bit(ipfwd_flags);
 			CVMX_SYNCW;
+			mutex_unlock(&cvm_ipfwd_table_mutex);
 			break;
 		default:
 			pr_err("Unknown action\n");
@@ -805,7 +836,8 @@ static ssize_t ipv4_fwd_cache_write(struct file *file, const char __user *buffer
 		src_port = htons(src_port);
 		dst_port = htons(dst_port);
 
-		for (i = 0; i < ipv4_cache_size; i++) {
+		mutex_lock(&cvm_ipfwd_table_mutex);
+		for (i = 0; cvm_gbl_ipv4_fwd_cache && i < ipv4_cache_size; i++) {
 
 			bucket = &cvm_gbl_ipv4_fwd_cache[i];
 
@@ -843,6 +875,7 @@ static ssize_t ipv4_fwd_cache_write(struct file *file, const char __user *buffer
 
 			}
 		}
+		mutex_unlock(&cvm_ipfwd_table_mutex);
 	} else {
 		pr_err("Unexpected input : %s\n", str);
 		pr_err("Usage:\n");
@@ -921,14 +954,16 @@ static ssize_t ipv6_fwd_cache_size_write(struct file *file, const char __user *i
 	buffer[size] = 0;
 	val = simple_strtoul(buffer, NULL, 10);
 
-	/* The size didn't change - do nothing. */
-	if (val == ipv6_cache_size && cvm_gbl_ipv6_fwd_cache) {
-		goto err;
+	/* Check if the value is 2^n. */
+	if (val == 0 || ((val & (val - 1)) != 0) || val > CVM_IPV6FWD_LUT_MAX) {
+		printk("Unsupported IPv6 forwarding cache table size %lu (must be 2^n, at most %u)\n", val, CVM_IPV6FWD_LUT_MAX);
+		return size;
 	}
 
-	/* Check if the value is 2^n. */
-	if (val == 0 || ((val & (val - 1)) != 0)) {
-		printk("Unsupported IPv6 forwarding cache table size %lu (must be 2^n)\n", val);
+	mutex_lock(&cvm_ipfwd_table_mutex);
+
+	/* The size didn't change - do nothing. */
+	if (val == ipv6_cache_size && cvm_gbl_ipv6_fwd_cache) {
 		goto err;
 	}
 
@@ -967,6 +1002,7 @@ static ssize_t ipv6_fwd_cache_size_write(struct file *file, const char __user *i
 	set_ipv6_bit(ipfwd_flags);
 	CVMX_SYNCW;
 err:
+	mutex_unlock(&cvm_ipfwd_table_mutex);
 	return size;
 }
 
@@ -3432,6 +3468,7 @@ static ssize_t ipv4_fwd_write(struct file *file, const char __user *input,
 
 	pr_info("IPV4 forwarding %s\n", (val ? "Enabled" : "Disabled"));
 
+	mutex_lock(&cvm_ipfwd_table_mutex);
 	if (val) {
 		if (!cvm_ipv4_fwd && !cvm_gbl_ipv4_fwd_cache) {
 			cvm_ipfwd_flow_bucket_t *cache;
@@ -3469,6 +3506,7 @@ static ssize_t ipv4_fwd_write(struct file *file, const char __user *input,
 	}
 
 err:
+	mutex_unlock(&cvm_ipfwd_table_mutex);
 	return size;
 }
 
